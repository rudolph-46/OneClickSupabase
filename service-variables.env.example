# ═══════════════════════════════════════════════════════════════════════════════
# db service — paste into Railway → db service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=${{shared.POSTGRES_PASSWORD}}
POSTGRES_DB=postgres
POSTGRES_USER=postgres
PGPORT=${{PORT}}


# ═══════════════════════════════════════════════════════════════════════════════
# auth service (GoTrue) — paste into Railway → auth service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
GOTRUE_API_HOST=0.0.0.0
PORT=${{PORT}}
GOTRUE_API_PORT=${{PORT}}
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:${{shared.POSTGRES_PASSWORD}}@${{shared.DB_HOST}}:${{shared.DB_PORT}}/${{shared.DB_NAME}}?search_path=auth
GOTRUE_SITE_URL=${{shared.SITE_URL}}
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_SECRET=${{shared.JWT_SECRET}}
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=${{shared.SMTP_HOST}}
GOTRUE_SMTP_PORT=${{shared.SMTP_PORT}}
GOTRUE_SMTP_USER=${{shared.SMTP_USER}}
GOTRUE_SMTP_PASS=${{shared.SMTP_PASS}}
GOTRUE_SMTP_SENDER_NAME=${{shared.SMTP_SENDER_NAME}}


# ═══════════════════════════════════════════════════════════════════════════════
# rest service (PostgREST) — paste into Railway → rest service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
PGRST_DB_URI=postgres://authenticator:${{shared.POSTGRES_PASSWORD}}@${{shared.DB_HOST}}:${{shared.DB_PORT}}/${{shared.DB_NAME}}
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_USE_LEGACY_GUCS=false
PGRST_JWT_SECRET=${{shared.JWT_SECRET}}
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_SERVER_PORT=${{PORT}}


# ═══════════════════════════════════════════════════════════════════════════════
# realtime service — paste into Railway → realtime service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
PORT=${{PORT}}
DB_HOST=${{shared.DB_HOST}}
DB_PORT=${{shared.DB_PORT}}
DB_USER=supabase_realtime_user
DB_PASSWORD=${{shared.POSTGRES_PASSWORD}}
DB_NAME=${{shared.DB_NAME}}
DB_AFTER_CONNECT_QUERY=SET search_path TO _realtime
DB_ENC_KEY=supabaserealtime
API_JWT_SECRET=${{shared.JWT_SECRET}}
FLY_ALLOC_ID=fly123
FLY_APP_NAME=realtime
SECRET_KEY_BASE=${{secret(64)}}
ERL_AFLAGS=-proto_dist inet_tcp
ENABLE_TAILSCALE=false
DNS_NODES=""


# ═══════════════════════════════════════════════════════════════════════════════
# storage service — paste into Railway → storage service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
ANON_KEY=${{shared.ANON_KEY}}
SERVICE_KEY=${{shared.SERVICE_ROLE_KEY}}
POSTGREST_URL=http://${{shared.PGRST_PRIVATE_HOST}}:${{shared.PGRST_PORT}}
PGRST_JWT_SECRET=${{shared.JWT_SECRET}}
DATABASE_URL=postgres://supabase_storage_admin:${{shared.POSTGRES_PASSWORD}}@${{shared.DB_HOST}}:${{shared.DB_PORT}}/${{shared.DB_NAME}}
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
PORT=${{PORT}}
# To use S3 instead of local disk, set these:
# STORAGE_BACKEND=s3
# GLOBAL_S3_BUCKET=your-bucket-name
# REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# studio service — paste into Railway → studio service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
PORT=${{PORT}}
STUDIO_PG_META_URL=http://${{shared.DB_HOST}}:${{shared.DB_PORT}}
POSTGRES_PASSWORD=${{shared.POSTGRES_PASSWORD}}
DEFAULT_ORGANIZATION_NAME=My Organization
DEFAULT_PROJECT_NAME=My Project
SUPABASE_URL=http://${{shared.PGRST_PRIVATE_HOST}}:${{shared.PGRST_PORT}}
SUPABASE_PUBLIC_URL=${{shared.SUPABASE_PUBLIC_URL}}
SUPABASE_ANON_KEY=${{shared.ANON_KEY}}
SUPABASE_SERVICE_KEY=${{shared.SERVICE_ROLE_KEY}}
LOGFLARE_API_KEY=
LOGFLARE_URL=
NEXT_PUBLIC_ENABLE_LOGS=false
NEXT_ANALYTICS_BACKEND_PROVIDER=postgres


# ═══════════════════════════════════════════════════════════════════════════════
# kong service — paste into Railway → kong service → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════
ANON_KEY=${{shared.ANON_KEY}}
SERVICE_ROLE_KEY=${{shared.SERVICE_ROLE_KEY}}
PGRST_PRIVATE_HOST=${{shared.PGRST_PRIVATE_HOST}}
PGRST_PORT=${{shared.PGRST_PORT}}
GOTRUE_PRIVATE_HOST=${{shared.GOTRUE_PRIVATE_HOST}}
GOTRUE_PORT=${{shared.GOTRUE_PORT}}
REALTIME_PRIVATE_HOST=${{shared.REALTIME_PRIVATE_HOST}}
REALTIME_PORT=${{shared.REALTIME_PORT}}
STORAGE_PRIVATE_HOST=${{shared.STORAGE_PRIVATE_HOST}}
STORAGE_PORT=${{shared.STORAGE_PORT}}
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/home/kong/kong.yml
KONG_DNS_ORDER=LAST,A,CNAME
KONG_PLUGINS=request-transformer,cors,key-auth,acl
KONG_NGINX_PROXY_PROXY_BUFFER_SIZE=160k
KONG_NGINX_PROXY_PROXY_BUFFERS=64 160k
