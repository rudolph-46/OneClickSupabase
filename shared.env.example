# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE ON RAILWAY — SHARED VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
#
# These go into Railway → Project Settings → Shared Variables.
# Every service then references them as ${{shared.VARIABLE_NAME}}.
# This is what prevents JWT mismatches — one secret, all services in sync.
#
# HOW TO USE:
#   1. Deploy all services first (they will fail — that's expected)
#   2. Deploy the init-jwt service and copy ANON_KEY + SERVICE_ROLE_KEY from logs
#   3. Fill in the values below and paste into Railway Shared Variables
#   4. Redeploy all services — everything starts clean
# ═══════════════════════════════════════════════════════════════════════════════


# ── SECRETS (generated by Railway template functions on first deploy) ─────────

# A strong random secret — Railway generates this automatically via ${{secret(40)}}
# DO NOT share this. Rotate by updating here + redeploying all services.
JWT_SECRET=${{secret(40)}}

# Postgres superuser password
POSTGRES_PASSWORD=${{secret(32)}}

# Dashboard login for Studio
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=${{secret(20)}}


# ── JWT KEYS (paste output from init-jwt service logs here) ──────────────────
#
# Leave blank on first deploy. Run init-jwt, copy the output, paste here,
# then redeploy. Never generate these manually — always use the init script.

ANON_KEY=
SERVICE_ROLE_KEY=


# ── SERVICE PRIVATE HOSTNAMES (filled automatically by Railway) ───────────────
#
# These reference each service's private domain.
# Format: ${{ServiceName.RAILWAY_PRIVATE_DOMAIN}}
# Replace "ServiceName" with the exact name you give each service in Railway.

DB_HOST=${{db.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_NAME=postgres

PGRST_PRIVATE_HOST=${{rest.RAILWAY_PRIVATE_DOMAIN}}
PGRST_PORT=3000

GOTRUE_PRIVATE_HOST=${{auth.RAILWAY_PRIVATE_DOMAIN}}
GOTRUE_PORT=9999

REALTIME_PRIVATE_HOST=${{realtime.RAILWAY_PRIVATE_DOMAIN}}
REALTIME_PORT=4000

STORAGE_PRIVATE_HOST=${{storage.RAILWAY_PRIVATE_DOMAIN}}
STORAGE_PORT=5000

STUDIO_PRIVATE_HOST=${{studio.RAILWAY_PRIVATE_DOMAIN}}
STUDIO_PORT=3000


# ── PUBLIC URLS (set after Kong gets its public domain) ───────────────────────
#
# After generating a public Railway domain for Kong, paste it here.
# Format: https://your-kong-service.up.railway.app

SUPABASE_PUBLIC_URL=https://PASTE_YOUR_KONG_DOMAIN_HERE

# Used by GoTrue for email confirmation links, OAuth redirects, etc.
SITE_URL=https://PASTE_YOUR_KONG_DOMAIN_HERE


# ── OPTIONAL: EMAIL (leave blank to disable email auth) ───────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
